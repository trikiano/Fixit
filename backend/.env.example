# Base de données PostgreSQL
DATABASE_URL="postgresql://fixit:fixit_password@localhost:5432/fixit_db"

# JWT — CHANGEZ IMPÉRATIVEMENT EN PRODUCTION !
JWT_SECRET=fixit-super-secret-jwt-key-change-this-in-production

# Serveur
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:3001

# Compte administrateur initial (utilisé par db:seed)
ADMIN_EMAIL=admin@fixit.local
ADMIN_PASSWORD=Admin1234!

# Répertoire uploads (optionnel, défaut: backend/uploads)
# UPLOAD_DIR=/data/uploads
